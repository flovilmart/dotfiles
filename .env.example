# Copy to .env next to compose.yml. Never commit .env.
SRC_DIR=/Users/you/src
DOCKER_SOCK=/Users/you/.rd/docker.sock        # Rancher Desktop; /var/run/docker.sock on Linux
CLAUDE_CODE_OAUTH_TOKEN=                      # output of `claude setup-token` on the Mac
GH_TOKEN=                                     # `gh auth token`, or a fine-grained PAT with repo scope
GIT_AUTHOR_NAME=Florent Vilmart
GIT_AUTHOR_EMAIL=florent@flovilmart.com
PLAYWRIGHT_VERSION=1.54.0                     # match the project's @playwright/test version
DEV_ENV_TAG=latest
# Forwarded SSH agent inside the container, if you prefer SSH remotes over GH_TOKEN:
# CONTAINER_SSH_AUTH_SOCK=/run/host-services/ssh-auth.sock
